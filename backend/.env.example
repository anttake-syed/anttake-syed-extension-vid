# Port for the Express server
PORT=3001

# Secret key for JWT signing (use a long, random string)
JWT_SECRET=your_long_random_secret_here

# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/
# 1. Create a project
# 2. Go to APIs & Services > Credentials
# 3. Create an "OAuth 2.0 Client ID"
# 4. Add http://localhost:3001/auth/callback to "Authorized redirect URIs"
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback

# Your hosted domain (set when deploying — leave blank for local dev)
# Example: https://antcapture.railway.app
APP_URL=

# Database Connection (Neon/Supabase)
# Example: postgresql://user:password@hostname/dbname?sslmode=require
DATABASE_URL=
