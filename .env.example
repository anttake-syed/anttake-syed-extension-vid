# ==========================================
# ANTCAPTURE DEPLOYMENT CONFIGURATION
# ==========================================
# Make a copy of this file and rename it to ".env"
# Then run `npm run setup` to automatically configure everything.

# 1. STORAGE MODE (local or drive)
# - local: Stores files on this server's hard drive and uses SQLite. (Easiest, no Google API keys needed).
# - drive: Stores files in the user's Google Drive and uses PostgreSQL.
STORAGE_BACKEND=local

# 2. APP URLS (Change these if deploying to a live server)
BACKEND_URL=http://localhost:3001
WEB_UI_URL=http://localhost:5173

# 3. GOOGLE OAUTH CREDENTIALS (Required if using 'drive' storage or Google Login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 4. SECURITY
JWT_SECRET=super_secret_jwt_string_change_this_in_production
