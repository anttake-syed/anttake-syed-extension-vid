{
  "manifest_version": 3,
  "name": "AntCapture: Record & Sync to Google Drive",
  "version": "1.0.0",
  "description": "Record your screen, capture screenshots, and automatically sync media to Google Drive via your personal web dashboard.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "unlimitedStorage",
    "identity",
    "scripting",
    "tabCapture",
    "offscreen",
    "notifications",
    "desktopCapture"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5175/*",
      "http://localhost:5173/*",
      "https://antcapture.anttake.com/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}