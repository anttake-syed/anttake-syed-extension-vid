generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Capture {
  id        Int      @id @default(autoincrement())
  email     String
  title     String?
  type      String
  size      String?
  fileUrl   String
  createdAt DateTime @default(now())
}