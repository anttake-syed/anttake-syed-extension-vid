generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./antcapture.db"
}

model Capture {
  id              Int      @id @default(autoincrement())
  email           String
  title           String?
  type            String
  size            String?
  mimeType        String?
  fileUrl         String
  driveUrl        String?
  storageLocation String   @default("drive")
  mediaData       Bytes?
  createdAt       DateTime @default(now())
}

model UserSettings {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  storagePreference String   @default("both")
  updatedAt         DateTime @updatedAt
}
model Feedback {
  id        Int      @id @default(autoincrement())
  email     String
  message   String
  createdAt DateTime @default(now())
}