# Port for the Express server
PORT=3001

# Secret key for JWT signing (use a long, random string)
JWT_SECRET=your_long_random_secret_here

# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/
# 1. Create a project
# 2. Go to APIs & Services > Credentials
# 3. Create an "OAuth 2.0 Client ID"
# 4. Add https://api.antcapture.anttake.com/auth/callback to "Authorized redirect URIs"
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://api.antcapture.anttake.com/auth/callback

# Web UI URL (used by CORS to allow requests from the dashboard)
WEB_UI_URL=http://localhost:5173

# --- SERVER MODE ---
# Set to 'cloud' for Production SaaS (Cloudflare D1 + Google OAuth + rate limits)
# Set to 'local' for Open-Source Self-Hosted (SQLite + filesystem, no OAuth required)
SERVER_MODE=local

# ── Cloudflare D1 Database (cloud mode only) ───────────────────────────────────
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# V2 Local Database (SQLite)
DATABASE_URL="file:./dev.db"

# ── LemonSqueezy ──────────────────────────────────────
LS_API_KEY=
LS_STORE_ID=
LS_WEBHOOK_SECRET=

# Variant IDs (from LS dashboard after creating products)
LS_VARIANT_CLOUD_MONTHLY=
LS_VARIANT_CLOUD_YEARLY=

# UploadThing (Optional Replacement for Cloud Provider)
UPLOADTHING_TOKEN=
